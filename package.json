{
  "name": "agent-core-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma reutilizable de agentes IA sobre un modelo canónico (Contacto / Interacción / Tarea / Recomendación). Agnóstica de dominio.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contracts",
    "packages/agent-core",
    "packages/agents",
    "apps/ejemplo",
    "apps/juridico"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"(lint pendiente)\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
