# Tenant por defecto en DEV (hasta enchufar Clerk). La costura resolveTenant lo usa.
DEV_TENANT=demo

# ── Datos reales de tu WISP (guaynet), SOLO LECTURA ────────────────────────────
# Sin esto, la app usa datos de ejemplo. Creá antes el usuario de solo lectura con
# apps/wisp/sql/solo-lectura.sql y poné su clave acá. Si guaynet corre en Docker
# en la misma máquina, su Postgres está en el puerto 5432 del host:
# WISP_DATABASE_URL=postgresql://agentcore_ro:TU_CLAVE@127.0.0.1:5432/guaynet
# WISP_TENANT=guaynet

# ── IA del chat con los agentes ────────────────────────────────────────────────
# Por defecto usa Ollama local (gratis, sin claves). Con 4 GB de RAM y sin GPU:
#   curl -fsSL https://ollama.com/install.sh | sh && ollama pull qwen2.5:1.5b
# AI_PROVIDER: "openai-compat" (default) | "mock" (respuestas falsas, para probar la UI) | "off"
# AI_PROVIDER=openai-compat
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:1.5b
# Para una API paga (OpenAI u otra compatible) cambiá estas tres y listo:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<modelo>
# AI_API_KEY=<tu clave>
# Costo por 1000 tokens (default 0 = local) y tope de gasto por tenant (sin definir = sin tope):
# AI_COST_IN_1K=0
# AI_COST_OUT_1K=0
# AI_BUDGET_TENANT=5

# PRODUCCIÓN (cuando conectes el store Prisma + Clerk):
# DATABASE_URL="postgresql://user:pass@host:5432/db"
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
